{
  "name": "wolfstar-error-pages",
  "version": "1.0.0",
  "private": true,
  "description": "The error pages Cloudflare serves for WolfStar.rocks, built to match the site's own error page.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/build.js && oxfmt --check",
    "dev": "node scripts/dev.js",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "serve . -l 3000"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/simple-icons": "1.2.100",
    "@iconify/utils": "3.1.7",
    "@tailwindcss/postcss": "4.3.3",
    "daisyui": "5.7.16",
    "oxfmt": "0.65.0",
    "postcss": "8.5.31",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=24"
  }
}
