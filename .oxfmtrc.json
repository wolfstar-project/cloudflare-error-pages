{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "proseWrap": "preserve",
  "sortPackageJson": true,
  "ignorePatterns": ["*/index.html", "src/assets/**", "pnpm-lock.yaml"]
}
